            "timeout": 300,
            "upgrade_install": null,
            "values": [
              "\"grafana\":\n  \"additionalDataSources\":\n  - \"access\": \"proxy\"\n    \"isDefault\": false\n    \"jsonData\":\n      \"httpHeaderName1\": \"X-Scope-OrgID\"\n    \"name\": \"Loki\"\n    \"secureJsonData\":\n      \"httpHeaderValue1\": \"1\"\n    \"type\": \"loki\"\n    \"url\": \"http://loki-gateway.observability.svc.cluster.local\"\n  - \"access\": \"proxy\"\n    \"isDefault\": false\n    \"jsonData\":\n      \"httpHeaderName1\": \"X-Scope-OrgID\"\n      \"httpHeaderValue1\": \"1\"\n    \"name\": \"Tempo\"\n    \"type\": \"tempo\"\n    \"url\": \"http://tempo.observability.svc.cluster.local:3100\"\n"
            ],
            "verify": false,
